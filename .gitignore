# =============================================================================
# VISALINX ROBOT - REGLAS DE SEGURIDAD GITIGNORE
# =============================================================================

# 1. Variables de entorno y secretos
.env
.env.*
*.env
!.env.example

# 2. Archivos JSON y CSV con credenciales de prueba o reales (¡Crítico!)
config*.json
config*.json*
*.csv

# 3. Entorno virtual de Python y dependencias
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 4. Logs, capturas de pantalla de Playwright y reportes
logs/*
!logs/.gitkeep
*.log
*.png
*.html
playwright-report/
test-results/

# 5. Sesiones de navegador persistentes y temporales
sesiones/
sesion_whatsapp/
.playwright/

# 6. Carpetas de Editores e IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# 7. Archivos de sistema operativo
.DS_Store
Thumbs.db
